# Jellyfin (inside the Jellyfin Docker network use http://jellyfin:8096; from another machine use your server's address)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Anthropic (or run `ant auth login` locally and leave this unset)
ANTHROPIC_API_KEY=

# Curation
# claude-sonnet-5 is about 2.5x cheaper than claude-opus-5 and holds the whole catalog; claude-haiku-4-5 only fits with overviews off
CURATOR_MODEL=claude-sonnet-5
CURATOR_SHELF_COUNT=6
CURATOR_ROTATE_PER_RUN=2
# home-screen rows, newest first; defaults to CURATOR_SHELF_COUNT
# CURATOR_ROW_COUNT=8
CURATOR_MIN_ITEMS=8
CURATOR_MAX_ITEMS=20
# all | recent (titles from the last 2 years keep their overview) | none
CURATOR_OVERVIEWS=recent
CURATOR_SEASONAL_SHELVES=2
# most shelves in one planner call; a bigger ask is split into batches
CURATOR_MAX_SHELVES_PER_CALL=6
# cover art for new collections, composed from members' backdrops (no tokens, no external service)
CURATOR_COVERS=true
CURATOR_HOME_ROWS=false
CURATOR_STREAMYFIN_ROWS=false
# cache the catalog block (only pays off on a shortfall retry; a cache write costs 1.25x)
CURATOR_CACHE_CATALOG=false
# with a daily cron, a real run happens only when the last one is at least this many days old (0 = every cron tick)
CURATOR_MIN_DAYS_BETWEEN_RUNS=4
CURATOR_STATE_PATH=/data/state.json
# CURATOR_LIBRARY_IDS=<comma-separated library ids to restrict to>
